{
  "name": "dev-digest-marketplace-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Static catalog UI for the dev-digest marketplace (GitHub Pages)",
  "scripts": {
    "catalog": "tsx scripts/build-catalog.ts",
    "catalog:offline": "tsx scripts/build-catalog.ts --no-network",
    "dev": "npm run catalog:offline && vite",
    "build": "npm run catalog && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "marked": "16.2.1",
    "minisearch": "7.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.6",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
